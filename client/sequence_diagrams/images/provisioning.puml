@startuml
!include ../../../images/common-sequence.iuml

title Client Device — Provisioning Flow

participant "Client\nFirmware" as Client
participant "Controller\nSoftAP" as AP
participant "Controller\nHTTP API" as API
participant "LittleFS" as FS

Client -> Client : boot with no stored config
Client -> Client : scan WiFi for SSID\n"FireFly-Provisioning" (exact match)
Client -> Client : read BSSID from scan result
Client -> Client : compute WPA2 password:\nnibble-interleave(BSSID)\ne.g. A1:B2:C3:D4:E5:F6 → A6B5C4D3E2F1
Client -> Client : set TX power to minimum\n(0 dBm / 1 mW)

Client -> AP++ : connect WPA2 using derived password
AP --> Client-- : connected (192.168.4.x via DHCP)

Client -> API++ : **Token Exchange**\nPOST /api/provisioning/token\n""{ "uuid": "...", "mac_address": "aa:bb:cc:dd:ee:ff" }""

break Request is not from SoftAP
    API --> Client : HTTP 403
end

break Provisioning mode inactive
    API --> Client : HTTP 409
end

API -> API : Validate UUID\ncheck client record exists

break UUID unknown
    API --> Client : HTTP 404
end

API --> Client-- : HTTP 200\n""{ "token": "..." }""

Client -> API++ : **Get client configuration**\nGET /api/clients/{uuid}\n""provisioning-token: {token}""

break Token invalid or expired
    API --> Client: HTTP 401
end

API --> Client-- : HTTP 200\n""{client config}""

Client -> FS : store config to /config.json

Client -> API++ : **Get client CA certificate**\nGET /api/provisioning/certs/client\n""provisioning-token: {token}""

alt No client CA certificate designated
    API --> Client-- : HTTP 404
    Client -> Client : continue without TLS
else success
    API --> Client-- : HTTP 200\n""{ fingerprint, pem }""
    Client -> FS : save /ca.pem + /ca_fp.txt
end

Client -> Client : disconnect from SoftAP
Client -> Client : reboot into normal mode

@enduml
