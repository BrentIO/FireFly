@startuml
!include ../../../../images/common-sequence.iuml

title MQTT — Edge Cases

box "On-Premises" $OnPrem
    participant "Controller" as ctl
    participant "MQTT Broker" as mqtt
    participant "Home Assistant" as ha
end box

group Update Server Unavailable //(OTA timer elapsed, server unreachable)//
    ctl -> ctl : OTA timer elapsed — server unreachable
    ctl -> mqtt : **Publish** retained\nFireFly/{UUID}/update/availability\n""offline""
    mqtt -> ha : **Publish**\nFireFly/{UUID}/update/availability
    ha -> ha : Firmware Update → Unavailable
end

group Temperature Hardware Failure
    ctl -> ctl : Temperature hardware error
    ctl -> mqtt : **Publish** retained\nFireFly/{UUID}/temperature/{location}/state\n""0""
    mqtt -> ha : **Publish**\nFireFly/{UUID}/temperature/{location}/state
    ha -> ha : Temperature → 0
end

group Network / MQTT Connection Failure //(Last Will and Testament)//
    ctl -x mqtt : Connection lost
    mqtt -> ha : **Publish** retained (Last Will)\nFireFly/{UUID}/availability\n""offline""
    ha -> ha : All entities → Unavailable
end

@enduml
