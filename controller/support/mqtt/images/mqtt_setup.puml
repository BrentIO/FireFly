@startuml
!include ../../../../images/common-sequence.iuml

title MQTT — Setup

box "On-Premises" $OnPrem
    participant "Controller" as ctl
    participant "MQTT Broker" as mqtt
    participant "Home Assistant" as ha
end box

ha -> mqtt : **Subscribe**\nhomeassistant/#

== MQTT Connect ==

ctl -> mqtt : **Connect** (Last Will) QoS 2, retained\nFireFly/{UUID}/availability\n""offline""

group Firmware Update Entity
    ctl -> mqtt : **Publish Auto Discovery** retained\nhomeassistant/update/FireFly-{UUID}-update/config\n""JSON payload""
    mqtt -> ha : **Publish Auto Discovery**\nhomeassistant/update/FireFly-{UUID}-update/config
    ha -> ha : Create firmware update entity\n(initially Unavailable)
    ctl -> mqtt : **Subscribe**\nFireFly/{UUID}/update/set
end

group Update Service Availability
    ctl -> mqtt : **Publish** retained\nFireFly/{UUID}/update/availability\n""offline""
    mqtt -> ha : **Publish**\nFireFly/{UUID}/update/availability
    ha -> ha : Firmware Update → Unavailable
end

group Temperature Sensor Auto Discovery //(one per sensor)//
    ctl -> mqtt : **Publish Auto Discovery** retained\nhomeassistant/sensor/FireFly-{UUID}-temperature-{location}/config\n""JSON payload""
    mqtt -> ha : **Publish Auto Discovery**\nhomeassistant/sensor/FireFly-{UUID}-temperature-{location}/config
    ha -> ha : Create temperature sensor\n(initially Unavailable)
end

group Output Auto Discovery //(one per output)//
    ctl -> mqtt : **Publish Auto Discovery** retained\nhomeassistant/{light|fan|switch}/{outputID}/config\n""JSON payload""
    mqtt -> ha : **Publish Auto Discovery**\nhomeassistant/{light|fan|switch}/{outputID}/config
    ha -> ha : Create output entity\n(initially Unavailable)
    ctl -> mqtt : **Subscribe**\nFireFly/circuits/{outputID}/set
    ctl -> mqtt : **Publish** retained\nFireFly/circuits/{outputID}/state\n""0""
    mqtt -> ha : **Publish**\nFireFly/circuits/{outputID}/state
    ha -> ha : Output → Off
end

group Diagnostic Sensor Auto Discovery
    ctl -> mqtt : **Publish Auto Discovery** retained\nhomeassistant/sensor/FireFly-{UUID}-time-start/config\n""JSON payload""
    mqtt -> ha : **Publish Auto Discovery**\nhomeassistant/sensor/FireFly-{UUID}-time-start/config
    ctl -> mqtt : **Publish Auto Discovery** retained\nhomeassistant/sensor/FireFly-{UUID}-ip-address/config\n""JSON payload""
    mqtt -> ha : **Publish Auto Discovery**\nhomeassistant/sensor/FireFly-{UUID}-ip-address/config
    ctl -> mqtt : **Publish Auto Discovery** retained\nhomeassistant/sensor/FireFly-{UUID}-mac-address/config\n""JSON payload""
    mqtt -> ha : **Publish Auto Discovery**\nhomeassistant/sensor/FireFly-{UUID}-mac-address/config
    ctl -> mqtt : **Publish Auto Discovery** retained\nhomeassistant/sensor/FireFly-{UUID}-count-errors/config\n""JSON payload""
    mqtt -> ha : **Publish Auto Discovery**\nhomeassistant/sensor/FireFly-{UUID}-count-errors/config
    ctl -> mqtt : **Publish Auto Discovery** retained\nhomeassistant/switch/FireFly-{UUID}-http-server/config\n""JSON payload""
    mqtt -> ha : **Publish Auto Discovery**\nhomeassistant/switch/FireFly-{UUID}-http-server/config
    ha -> ha : Create diagnostic sensors\n(initially Unavailable)
end

opt Debug builds only
    ctl -> mqtt : **Publish Auto Discovery** retained\nhomeassistant/sensor/FireFly-{UUID}-heap-free/config\n""JSON payload""
    mqtt -> ha : **Publish Auto Discovery**\nhomeassistant/sensor/FireFly-{UUID}-heap-free/config
    ha -> ha : Create heap-free sensor\n(initially Unavailable)
    ctl -> mqtt : **Publish Auto Discovery** retained\nhomeassistant/sensor/FireFly-{UUID}-heap-largest-free-block/config\n""JSON payload""
    mqtt -> ha : **Publish Auto Discovery**\nhomeassistant/sensor/FireFly-{UUID}-heap-largest-free-block/config
    ha -> ha : Create heap-largest-free-block sensor\n(initially Unavailable)
end

group Publish Availability
    ctl -> mqtt : **Publish** retained\nFireFly/{UUID}/availability\n""online""
    mqtt -> ha : **Publish**\nFireFly/{UUID}/availability
    ha -> ha : All entities → Available
end

group Publish Initial States
    ctl -> mqtt : **Publish** retained\nFireFly/{UUID}/temperature/{location}/state\n""<float>""
    ctl -> mqtt : **Publish** retained\nFireFly/{UUID}/time-start/state\n""<epoch>""
    ctl -> mqtt : **Publish** retained\nFireFly/{UUID}/ip-address/state\n""<ip>""
    ctl -> mqtt : **Publish** retained\nFireFly/{UUID}/mac-address/state\n""<mac>""
    ctl -> mqtt : **Publish** retained\nFireFly/{UUID}/count-errors/state\n""<count>""
    ctl -> mqtt : **Publish** retained\nFireFly/{UUID}/http-server/state\n""ON"" or ""OFF""
    mqtt -> ha : **Publish** //(6 messages)//
    ha -> ha : Entities reflect current values
end

@enduml
