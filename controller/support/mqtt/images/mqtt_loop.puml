@startuml
!include ../../../../images/common-sequence.iuml

title MQTT — Loop

box "On-Premises" $OnPrem
    participant "Controller" as ctl
    participant "MQTT Broker" as mqtt
    participant "Home Assistant" as ha
end box

group OTA Firmware Check //(timer-based)//
    ctl -> ctl : OTA timer elapsed
    ctl -> mqtt : **Publish** retained\nFireFly/{UUID}/update/availability\n""online""
    mqtt -> ha : **Publish**\nFireFly/{UUID}/update/availability
    ha -> ha : Firmware Update → Available for check
    ctl -> mqtt : **Publish**\nFireFly/{UUID}/update/state\n""JSON payload""
    mqtt -> ha : **Publish**\nFireFly/{UUID}/update/state
    ha -> ha : Firmware entity: Up-to-date or Update Available
end

group Temperature State //(on change threshold)//
    ctl -> ctl : Temperature change exceeds threshold
    ctl -> mqtt : **Publish** retained\nFireFly/{UUID}/temperature/{location}/state\n""<float>""
    mqtt -> ha : **Publish**\nFireFly/{UUID}/temperature/{location}/state
    ha -> ha : Temperature → new value
end

group Output State //(on value change)//
    ha -> mqtt : **Publish**\nFireFly/circuits/{outputID}/set\n""<value>""
    mqtt -> ctl : **Publish**\nFireFly/circuits/{outputID}/set
    ctl -> ctl : Apply output value
    ctl -> mqtt : **Publish** retained\nFireFly/circuits/{outputID}/state\n""<value>""
    mqtt -> ha : **Publish**\nFireFly/circuits/{outputID}/state
    ha -> ha : Output → new value
end

group Error Count //(on error log change)//
    ctl -> ctl : Error log size changed
    ctl -> mqtt : **Publish** retained\nFireFly/{UUID}/count-errors/state\n""<count>""
    mqtt -> ha : **Publish**\nFireFly/{UUID}/count-errors/state
    ha -> ha : Error Count → new value
end

opt Debug builds only //(timer-based)//
    ctl -> mqtt : **Publish**\nFireFly/{UUID}/heap-free/state\n""<bytes>""
    mqtt -> ha : **Publish**\nFireFly/{UUID}/heap-free/state
    ha -> ha : Heap Free → new value
    ctl -> mqtt : **Publish**\nFireFly/{UUID}/heap-largest-free-block/state\n""<bytes>""
    mqtt -> ha : **Publish**\nFireFly/{UUID}/heap-largest-free-block/state
    ha -> ha : Heap Largest Free Block → new value
end

@enduml
