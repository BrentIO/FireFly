@startuml
!include ../../../../../images/common-sequence.iuml

title Deploy — Single Controller

participant "Browser\n(Configurator)" as Browser

box "Target Controller" $OnPrem
    participant "HTTP API" as API
end box

Browser -> Browser : **Compute SHA-256**\nof local Dexie export\n(cached from page load)

opt certificates defined
    loop for each certificate
        Browser -> API++ : **Push certificate**\nPOST /certs\n{certificate payload}
        API --> Browser-- : HTTP 200
    end
end

loop for each controller in Dexie
    Browser -> API++ : **Push controller config**\nPUT /controllers/{uuid}\n{controller config}
    API --> Browser-- : HTTP 200
end

loop for each client in Dexie
    Browser -> API++ : **Push client config**\nPUT /clients/{uuid}\n{client config}
    API --> Browser-- : HTTP 200
end

Browser -> API++ : **Push backup**\nPUT /backup\n{Dexie export plaintext}
API --> Browser-- : HTTP 200

Browser -> API++ : **Verify deployment**\nHEAD /backup
API --> Browser-- : HTTP 200\nETag: ""<sha256-hex>""

alt ETag matches local Dexie SHA-256
    Browser -> Browser : **In Sync**\nDeployment Required indicator cleared
else ETag mismatch or absent
    Browser -> Browser : **Deployment Required**\nindicator set
end

@enduml
