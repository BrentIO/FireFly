@startuml
!include ../../../../../images/common.iuml

title Extended Client — Channel Mapping and Port Assignment

skinparam defaultTextAlignment left
skinparam rectangle {
    BorderColor black
    BackgroundColor white
}
skinparam package {
    BorderColor black
    BackgroundColor white
    FontStyle bold
}

package "Controller" as CTL {
    rectangle "Port A (odd-numbered)\nPrimary client" as PA #lightblue
    rectangle "Port B (even-numbered)\nSecondary client" as PB #lightyellow
}

package "Client Device (HID)" as HID {
    package "RJ-45 Jack A  →  Primary" as JA {
        rectangle "Pin 1: White/Orange → Logical Channel 1" as JA1 #FFE5CC
        rectangle "Pin 2: Orange       → Logical Channel 2" as JA2 #FFAA44
        rectangle "Pin 3: White/Green  → Logical Channel 3" as JA3 #E8FFE8
        rectangle "Pin 4: Blue         → +12 VDC" as JA4 #AABBFF
        rectangle "Pin 5: White/Blue   → +12 VDC" as JA5 #E0EEFF
        rectangle "Pin 6: Green        → Logical Channel 4" as JA6 #AAFFAA
        rectangle "Pin 7: White/Brown  → Ground" as JA7 #F5E8D8
        rectangle "Pin 8: Brown        → Ground" as JA8 #CCAA88
    }

    package "RJ-45 Jack B  →  Secondary (extended)" as JB {
        rectangle "Pin 1: White/Orange → Logical Channel 5" as JB1 #FFE5CC
        rectangle "Pin 2: Orange       → Logical Channel 6" as JB2 #FFAA44
        rectangle "Pin 3: White/Green  → (unused)" as JB3 #E8FFE8
        rectangle "Pin 4: Blue         → +12 VDC" as JB4 #AABBFF
        rectangle "Pin 5: White/Blue   → +12 VDC" as JB5 #E0EEFF
        rectangle "Pin 6: Green        → (unused)" as JB6 #AAFFAA
        rectangle "Pin 7: White/Brown  → Ground" as JB7 #F5E8D8
        rectangle "Pin 8: Brown        → Ground" as JB8 #CCAA88
    }
}

PA --> JA : Cat6 cable
PB --> JB : Cat6 cable

note bottom of CTL
  Both ports must be assigned to the same Controller.
  The UI prevents assigning them to different Controllers.
end note

note bottom of HID
  Power supply voltage is +12 VDC on hardware version 2603 and later;
  +9 VDC on earlier hardware versions.
end note

@enduml
